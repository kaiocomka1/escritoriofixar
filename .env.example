# Configure ONLY in Vercel > Project > Settings > Environment Variables
# Never commit real secrets.
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=https://escritoriofixar.vercel.app/api/shopee/callback
# Reserved for a later authenticated administration interface:
FIXAR_ADMIN_TOKEN=

# Explicit sandbox binding; set only after verifying the store in Supabase.
SHOPEE_SANDBOX_STORE_ID=
SHOPEE_SANDBOX_WRITES_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SHOPEE_TOKEN_ENCRYPTION_KEY=
